#!/bin/sh
# Public pcbforge command dispatcher. The bootstrap selects the clean checkout
# pinned by the target project before any project-aware code is imported.
set -eu

tool_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
venv_python="$tool_root/toolchain/.venv/bin/python"

if [ ! -x "$venv_python" ]; then
  echo "pcbforge: launcher venv missing — run: uv sync --project '$tool_root/toolchain'" >&2
  exit 2
fi

exec "$venv_python" "$tool_root/scripts/pcbforge_bootstrap.py" "$tool_root" "$@"
